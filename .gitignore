# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is committed because this repository ships an executable app.

# App bundle build output
build/

# OMC / agent local state
.omc/

# macOS
.DS_Store
*.xcuserstate

# JetBrains IDE
.idea/

# Signing material — never commit private keys / certs
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# Personal dev notes (kept locally, not published).
# docs/reference/ is the exception: published agent/contributor reference docs.
# (Must ignore docs/* rather than docs/ — git cannot re-include inside an excluded directory.)
docs/*
!docs/reference/

# TDD 워크플로우가 만드는 증거 문서 — 로컬 전용, 원격에 올리지 않는다.
# (`.claude/`·`docs/*` 는 이미 무시되지만 `docs/reference/` 가 예외라 확장자로 한 번 더 막는다.)
*.tdd.md

# Agent worktrees / local state
.claude/
.worktrees/

# Local-only review-gate opt-out (not published)
.no-review-gate
