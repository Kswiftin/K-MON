# Swift Package Manager
.build/
.swiftpm/
# Package.resolved is committed because this repository ships an executable app.

# App bundle build output
build/

# OMC / agent local state
.omc/

# macOS
.DS_Store
*.xcuserstate

# JetBrains IDE
.idea/

# Signing material — never commit private keys / certs
*.p12
*.pem
*.key
*.cer
*.certSigningRequest

# 공개 문서만 허용한다. 작업용 스펙·계획과 개인 메모는 로컬에 남긴다.
# docs/ 자체를 제외하면 하위 공개 경로를 다시 포함할 수 없으므로 docs/*를 쓴다.
docs/*
!docs/README.md
!docs/guides/
!docs/development/
!docs/reference/
docs/**/specs/
docs/**/plans/

# TDD 워크플로우가 만드는 증거 문서 — 로컬 전용, 원격에 올리지 않는다.
# 공개 문서 경로 안에서도 작업 증거 파일은 제외한다.
*.tdd.md

# Agent worktrees / local state
.claude/
.worktrees/

# Local-only review-gate opt-out (not published)
.no-review-gate

# Showdown/PokeAPI extraction cache (scripts/extract-showdown-moves.mjs)
.cache/
